POSTGRES_DB=northstar
POSTGRES_USER=northstar
POSTGRES_PASSWORD=synthetic-local-only
DATABASE_URL=postgresql+psycopg://northstar:synthetic-local-only@localhost:55432/northstar
LOG_LEVEL=INFO
DATABASE_TIMEOUT_SECONDS=3
AI_PROVIDER=mock
POSTGRES_PORT=55432

# Local HTTP only. Production requires APP_ENV=production, COOKIE_SECURE=true,
# and an explicit HTTPS TRUSTED_ORIGINS JSON array. No demo password in production.
APP_ENV=development
COOKIE_SECURE=false
TRUSTED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SESSION_TTL_SECONDS=3600
# Set DEMO_PASSWORD only in your ignored .env or process environment (14+ characters).
# It has intentionally no example/default value.

# Phase 3 server-controlled investigation limits; no caller overrides.
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=8
AGENT_WALL_SECONDS=8
AGENT_MAX_REPEATS=1
AGENT_OBSERVATION_BYTES=48000
AGENT_PLANNING_ITERATIONS=8

# Operational evidence freshness (historical ledger relevance is separate).
EVIDENCE_FRESHNESS_SECONDS=86400

# Phase 6: deterministic mock remains default. Opt in explicitly; never commit keys.
# AI_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_REQUESTS=8
LLM_TOTAL_OUTPUT_TOKENS=8192
LLM_MAX_COST_MICROUSD=100000
# Set positive provider/model-specific rates before enabling the adapter.
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
PLANNER_CONTEXT_BYTES=65536

# Phase 9 worker uses DATABASE_URL and no extra broker or credential.
# Fixed safety caps: 4 global / 1 per tenant, 30s leases, 3 attempts (5 lifetime), 10m window.
